# IDE project files (PyCharm) — personal, not shared source
.idea/

# Virtual environment
.venv/

# Python bytecode
__pycache__/
*.pyc

# Test artifacts
.pytest_cache/

# Machine-specific settings (serial ports, baud rates, local folder paths).
# The app falls back to sensible defaults (SettingsService.DEFAULTS) when
# this file doesn't exist, so a fresh clone works fine without it.
data/settings.json

# Regenerated automatically on first run (a few seconds) from the committed
# Natural Earth shapefiles — see services/coastline_service.py.
data/naturalearth/**/*.cache.json

# Nearest-shore distance per UK town, regenerated from the committed
# GeoNames data + coastline — see services/shore_distance_service.py.
# (The Natural Earth places' equivalent cache already matches the pattern
# above, since it also ends in .cache.json.)
data/geonames/**/*.shore_distance.cache.json

# Live session recordings — user-generated data, not source.
data/recordings/

# Crash traceback log — see services/crash_handler.py. Runtime output, not
# source, and can capture whatever the app was doing (positions, filenames)
# at the moment it crashed.
data/crash.log

# Real field-test capture logs — can bake in a real receiver's test
# location, so kept local rather than committed. See resources/README.md.
# sample_replay.log is fully synthetic (see scripts/generate_sample_log.py)
# and safe to publish, so it's the one exception.
resources/*
!resources/README.md
!resources/sample_replay.log
